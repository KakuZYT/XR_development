  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 028dec5536905af45ba56d38d954a849, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleXRHoverInfo
  objectName: Clownfish
  description: Clownfish, also known as anemonefish, are vibrant marine fish instantly
    recognizable by their bright orange bodies and striking white stripes. Native
    to the warm coral reefs of the Indian and Pacific Oceans, they are most famous
    for their unique symbiotic relationship with sea anemones. Thanks to a special
    protective mucus layer on their skin, clownfish can safely shelter within the
    anemone's venomous tentacles, hiding from predators while helping to clean their
    host in return. Fascinatingly, these small omnivores have a strict social hierarchy
    where all individuals are born male, and the largest, most dominant fish in the
    colony permanently transitions into a female to lead the group.
  objectInfoCanvas: {fileID: 626478486}
  infoPanel: {fileID: 1365102933}
  infoText: {fileID: 496564549}
  progressCircle: {fileID: 1459134083}
  progressImage: {fileID: 1459134085}
  showDelay: 3
